// Phase 6 (Historical Data + Charts) storage. This is the MVP form of the
// "Postgres tables with scheduled aggregation" storage decision in
// docs/phase-1/README.md §1 — a specialized time-series store (Timescale/
// ClickHouse) is an explicitly deferred upgrade, not adopted speculatively.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One row per contract per sample. Written by the historical collector
/// (apps/web/lib/historicalCollector.ts) on a bounded interval — never on
/// every provider tick — per FR-22 (no raw tick history reaches storage
/// unaggregated at the source, and never reaches the browser at all).
model ContractSnapshot {
  id            String   @id @default(cuid())
  instrument    String
  expiry        String
  strike        Int
  optionType    String // "CE" | "PE"
  capturedAt    DateTime
  ltp           Float?
  oi            Int?
  volume        Int?
  iv            Float?

  @@index([instrument, expiry, strike, optionType, capturedAt])
}

/// One row per instrument/expiry per sample, for chain-level historical
/// metrics (PCR, Max Pain, underlying price) that don't belong to a single
/// strike.
model ChainSnapshot {
  id              String   @id @default(cuid())
  instrument      String
  expiry          String
  capturedAt      DateTime
  underlyingPrice Float
  pcr             Float?
  maxPain         Float?

  @@index([instrument, expiry, capturedAt])
}

// ---------------------------------------------------------------------
// Phase 8 (User Accounts + Watchlists + Alerts)
// ---------------------------------------------------------------------

/// A plan is a name the centralized entitlement module (packages/entitlements)
/// resolves to a set of limits. This is intentionally just an enum column,
/// not a billing record — Phase 11 (Free-to-Premium SaaS) owns subscriptions,
/// trials, and payment webhooks; this column is the minimal seam Phase 11
/// will attach to, not a partial implementation of it.
enum Plan {
  FREE
  PREMIUM
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  /// scrypt-hashed, never a plaintext password and never a third-party
  /// OAuth token (no OAuth provider is wired up yet — see docs/phase-8).
  passwordHash String
  name         String?
  plan         Plan     @default(FREE)
  createdAt    DateTime @default(now())

  watchlists    Watchlist[]
  alerts        Alert[]
  recentSearches RecentSearch[]
  subscription  Subscription?
  billingEvents BillingEvent[]
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @default("My Watchlist")
  createdAt DateTime @default(now())

  items WatchlistItem[]

  @@index([userId])
}

model WatchlistItem {
  id          String    @id @default(cuid())
  watchlistId String
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  instrument  String
  /// Null expiry/strike/optionType means "watch the instrument as a whole"
  /// rather than one specific contract.
  expiry      String?
  strike      Int?
  optionType  String?
  createdAt   DateTime  @default(now())

  @@unique([watchlistId, instrument, expiry, strike, optionType])
  @@index([watchlistId])
}

enum AlertType {
  LTP_THRESHOLD
  PERCENT_MOVE
  OI_CHANGE
  VOLUME_SPIKE
  IV_THRESHOLD
  IMPORTANT_STRIKE_MOVE
  SR_CROSSING
  UNUSUAL_ACTIVITY
}

/// A flat (non-JSON) condition shape: `operator` + `thresholdValue` cover
/// every threshold-style alert type, and `strike`/`optionType` scope it to
/// a contract (or, for the two chain-level types, just to a strike level).
/// See packages/core/src/alerts.ts (`evaluateAlert`) for the deterministic
/// rule each AlertType maps to.
model Alert {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrument      String
  expiry          String
  strike          Int?
  optionType      String?
  type            AlertType
  operator        String? // "gte" | "lte"
  thresholdValue  Float?
  active          Boolean   @default(true)
  lastTriggeredAt DateTime?
  createdAt       DateTime  @default(now())

  triggers AlertTrigger[]

  @@index([userId])
  @@index([instrument, expiry, active])
}

/// A record of each time an alert's condition was actually met. This is
/// the Phase 8 "notification infrastructure" in its MVP form — it proves
/// the detection loop works end-to-end and gives the user a visible
/// history. Real delivery (email/push/SMS) is out of scope here: it needs
/// a real provider and credentials this environment doesn't have, and the
/// project rule is never to fabricate those. See docs/phase-8/README.md.
model AlertTrigger {
  id          String   @id @default(cuid())
  alertId     String
  alert       Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  triggeredAt DateTime @default(now())
  message     String

  @@index([alertId])
}

model RecentSearch {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrument String
  expiry     String?
  strike     Int?
  optionType String?
  searchedAt DateTime @default(now())

  @@index([userId, searchedAt])
}

// ---------------------------------------------------------------------
// Phase 11 (Free-to-Premium SaaS)
// ---------------------------------------------------------------------

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
}

/// One row per user, tracking the source of truth for their plan.
/// `provider`/`providerCustomerId`/`providerSubscriptionId` are populated
/// only when a real payment provider (Stripe) is wired up — see
/// packages/billing. A row with `provider: null` means the plan was set
/// manually (the Phase 11 dev/demo upgrade path — see docs/phase-11 —
/// never a real payment), which is exactly how this ships in this
/// environment, since no real Stripe account exists here and the project
/// rule is never to fabricate payment credentials.
model Subscription {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                   Plan               @default(FREE)
  status                 SubscriptionStatus @default(ACTIVE)
  provider               String?
  providerCustomerId     String?
  providerSubscriptionId String?
  currentPeriodEnd       DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
}

/// An append-only audit log of plan changes, satisfying the project's
/// "audit logging for sensitive actions" security rule (billing/plan
/// changes are exactly that kind of action).
model BillingEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // e.g. "manual_upgrade", "manual_downgrade", "stripe_webhook:checkout.session.completed"
  detail    String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
